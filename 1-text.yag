{{$args := parseArgs 1 "`>text play/ST`" (carg "string" "role")}}
{{$role := $args.Get 0}}
{{$keyP := (printf `p-%d` .User.ID)}}
{{$keyST := `textST`}}
 
 
{{if eq $role `play`}}
{{if hasRole "Text Game Player"}}
	{{- removeRole "Text Game Player"}}
	```Removed the text game role.```
	{{dbDel 1 $keyP}}
{{else}}
	{{- addRole "Text Game Player"}}
	```Added the text game role.```
	{{dbSet 1 $keyP (str .User.ID) }}
{{end}}
{{addReactions "🫛"}}
{{end}}
 
{{if or (eq $role `ST`) (eq $role `st`) }}
	{{if hasRole "Text ST"}}
		{{- removeRole "Text ST"}}
		```Removed the text ST role.```
		{{dbDel 1 $keyST}}
	{{else}}
	{{- addRole "Text ST"}}
		```Added the text ST role.```
		{{dbSet 1 $keyST (str .User.ID) }}
	{{end}}
	{{addReactions "🫛"}}
{{end}}