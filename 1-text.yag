{{$args := parseArgs 1 "`>text play/ST`" (carg "string" "role")}}
{{$role := $args.Get 0}}
{{$keyP := (printf `p-%d` .User.ID)}}
{{$keyST := `textST`}}
 
 
{{if eq $role `play`}}
{{if hasRole "/1/"}}
	{{- removeRole "/1/"}}
	```Removed the text game role.```
	{{dbDel 1 $keyP}}
{{else}}
	{{- addRole "/1/"}}
	```Added the text game role.```
	{{dbSet 1 $keyP (str .User.ID) }}
{{end}}
{{addReactions "🫛"}}
{{end}}
 
{{if or (eq $role `ST`) (eq $role `st`) }}
	{{if hasRole "/2/"}}
		{{- removeRole "/2/"}}
		```Removed the /2/ role.```
		{{dbDel 1 $keyST}}
	{{else}}
	{{- addRole "/2/"}}
		```Added the /2/ role.```
		{{dbSet 1 $keyST (str .User.ID) }}
	{{end}}
	{{addReactions "🫛"}}
{{end}}
